{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-log-viewer",
            "type": "process",
            "command": "python",
            "args": ["${workspaceFolder}/log_viewer.py"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Log viewer",
                    "endsPattern": "^Log viewer running"
                }
            }
        }
    ]
}
